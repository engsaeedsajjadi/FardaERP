# FardaERP Docker stack — environment template (§26)
# Copy to `.env` and FILL REAL VALUES. NEVER commit `.env`.
# Generate strong values:  openssl rand -hex 24

# Frappe site served by the stack (single-site). Use localhost for a local
# test, or your domain in production, e.g. erp.example.ir
SITE_NAME=erp.farda.local

# Host port for the web UI (http://localhost:<HTTP_PORT>). Change it if port 80
# is already used on this machine (IIS, another container, Skype, ...).
HTTP_PORT=80

# MariaDB root password. NOTE: only applied when the db-data volume is created
# the FIRST time; changing it later does not change the real root password (container bootstrap + bench new-site/restore)
DB_ROOT_PASSWORD=__CHANGE_ME__

# Application DB user password (passed to `bench new-site --db-password`)
DB_PASSWORD=__CHANGE_ME__

# Set to 1 ONLY on the deploy/maintenance backend container to run
# `bench --site $SITE_NAME migrate` at startup (see docs/DOCKER.md §5)
RUN_MIGRATIONS=0

# ---------------- FardaERP integrations ----------------
# OTP hashing pepper (REQUIRED for OTP; generate: openssl rand -hex 32)
FARDA_OTP_PEPPER=
# SMS provider: console (dev, logs only) | kavenegar | melipayamak | ghasedak
FARDA_SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER=
GHASEDAK_API_KEY=
GHASEDAK_SENDER=
# comma-separated mobiles that receive admin alert SMS
FARDA_ALERT_SMS_NUMBERS=
# Payment gateway: zarinpal | idpay | nextpay ; SANDBOX=1 uses the gateway test endpoints
FARDA_PAYMENT_GATEWAY=zarinpal
FARDA_PAYMENT_SANDBOX=1
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
NEXTPAY_API_KEY=

# ---- سامانه مودیان (Tax Affairs portal) -------------------------------------
# شناسه یکتای حافظه مالیاتی (6 characters, from کارپوشه › عضویت)
FARDA_MOADIAN_MEMORY_ID=
# Host folder holding private.pem and certificate.pem (keep it OUTSIDE git, chmod 600).
# It is mounted read-only at /run/secrets/moadian inside the containers.
MOADIAN_KEYS_DIR=./secrets/moadian
# FARDA_MOADIAN_PRIVATE_KEY_PATH=/run/secrets/moadian/private.pem
# FARDA_MOADIAN_CERT_PATH=/run/secrets/moadian/certificate.pem
FARDA_MOADIAN_PRIVATE_KEY_PASSWORD=
# sandbox (default) | live. Live also needs FARDA_MOADIAN_ALLOW_LIVE=1.
FARDA_MOADIAN_TARGET=sandbox
# Sandbox API base. Default https://sandboxrc.tax.gov.ir/requestsmanager/api/v2/ is
# not in the official spec — confirm it with your trusted company and set it here.
FARDA_MOADIAN_SANDBOX_BASE_URL=
FARDA_MOADIAN_ALLOW_LIVE=0
