# FardaERP Docker stack — environment template (§26)
# Copy to `.env` and FILL REAL VALUES. NEVER commit `.env`.
# Generate strong values:  openssl rand -hex 24

# Site name served by the stack (Host header). For a single-site deployment
# set it to your domain, e.g. erp.example.ir
SITE_NAME=erp.farda.local

# MariaDB root password (container bootstrap + bench new-site/restore)
DB_ROOT_PASSWORD=__CHANGE_ME__

# Application DB user password (passed to `bench new-site --db-password`)
DB_PASSWORD=__CHANGE_ME__

# nginx server_name template value. Keep `$host` for multi-site-by-Host,
# or set a fixed hostname (must equal SITE_NAME for single-site).
FRAPPE_SITE_NAME_HEADER=$host

# Set to 1 ONLY on the deploy/maintenance backend container to run
# `bench --site $SITE_NAME migrate` at startup (see docs/DOCKER.md §5)
RUN_MIGRATIONS=0
