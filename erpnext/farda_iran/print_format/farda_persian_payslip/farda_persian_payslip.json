 "doctype": "Print Format",
 "font_size": 12,
 "html": "{%- set c = payslip_context(doc) -%}\n<div dir=\"rtl\" style=\"font-family: Vazirmatn, Vazir, Tahoma, sans-serif; direction: rtl; text-align: right; color: #111; font-size: 12.5px; line-height: 1.8;\">\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 8px;\">\n    <tr>\n      <td style=\"vertical-align: top;\">\n        <div style=\"font-size: 16px; font-weight: 700;\">فیش حقوق {{ c.month }} {{ fa(c.year) }}</div>\n        <div>{{ c.company | e }}</div>\n      </td>\n      <td style=\"text-align: left; vertical-align: top;\">\n        <div>شماره فیش: {{ fa(doc.name) }}</div>\n        <div>از {{ fa(format_jalali_date(doc.start_date)) }} تا {{ fa(format_jalali_date(doc.end_date)) }}</div>\n        {%- if c.workshop_code %}<div>کد کارگاه: {{ fa(c.workshop_code) }}</div>{% endif %}\n      </td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 8px;\" border=\"1\" cellpadding=\"4\">\n    <tr>\n      <td style=\"width: 34%;\">نام و نام خانوادگی: <b>{{ c.employee.name | e }}</b></td>\n      <td style=\"width: 33%;\">کد پرسنلی: {{ fa(c.employee.code) }}</td>\n      <td style=\"width: 33%;\">کد ملی: {{ fa(c.employee.national_id or \"-\") }}</td>\n    </tr>\n    <tr>\n      <td>سمت: {{ (c.employee.designation or \"-\") | e }}</td>\n      <td>شماره بیمه: {{ fa(c.employee.insurance_number or \"-\") }}</td>\n      <td>روزهای کارکرد: {{ fa(\"%g\"|format(c.days)) }}{% if c.overtime_hours %} — اضافه‌کاری: {{ fa(\"%g\"|format(c.overtime_hours)) }} ساعت{% endif %}</td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr>\n      <td style=\"width: 50%; vertical-align: top; padding-left: 4px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\" border=\"1\" cellpadding=\"4\">\n          <tr style=\"background: #eef2f0;\"><th>مزایا</th><th style=\"width: 42%;\">مبلغ (ریال)</th></tr>\n          {%- for r in c.earnings %}\n          <tr><td>{{ r.name | e }}</td><td style=\"text-align: left;\">{{ rial(r.amount) }}</td></tr>\n          {%- endfor %}\n          <tr style=\"font-weight: 700;\"><td>جمع مزایا</td><td style=\"text-align: left;\">{{ rial(c.gross) }}</td></tr>\n        </table>\n      </td>\n      <td style=\"width: 50%; vertical-align: top; padding-right: 4px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\" border=\"1\" cellpadding=\"4\">\n          <tr style=\"background: #f5eeee;\"><th>کسور</th><th style=\"width: 42%;\">مبلغ (ریال)</th></tr>\n          {%- for r in c.deductions %}\n          <tr><td>{{ r.name | e }}</td><td style=\"text-align: left;\">{{ rial(r.amount) }}</td></tr>\n          {%- endfor %}\n          <tr style=\"font-weight: 700;\"><td>جمع کسور</td><td style=\"text-align: left;\">{{ rial(c.total_deduction) }}</td></tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 8px;\" border=\"1\" cellpadding=\"5\">\n    <tr style=\"font-size: 14px; font-weight: 700; background: #eef2f0;\">\n      <td style=\"width: 40%;\">خالص پرداختی</td>\n      <td style=\"text-align: left;\">{{ rial(c.net) }} ریال</td>\n    </tr>\n    <tr><td colspan=\"2\">به حروف: {{ money_words_irr(c.net) }}</td></tr>\n    {%- if c.employee.iban %}<tr><td>واریز به شبا</td><td style=\"text-align: left;\">{{ fa(c.employee.iban) }}</td></tr>{% endif %}\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 11.5px; color: #444;\" border=\"1\" cellpadding=\"3\">\n    <tr>\n      <td>مبنای بیمه: {{ rial(c.insurance_base) }}</td>\n      <td>سهم کارفرما: {{ rial(c.employer_insurance) }}</td>\n      <td>بیمه بیکاری: {{ rial(c.unemployment) }}</td>\n      <td>درآمد مشمول مالیات: {{ rial(c.tax_base) }}</td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; margin-top: 28px;\">\n    <tr>\n      <td style=\"text-align: center;\">امضای واحد مالی</td>\n      <td style=\"text-align: center;\">امضای کارمند</td>\n    </tr>\n  </table>\n</div>",
