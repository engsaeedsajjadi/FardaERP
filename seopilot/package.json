{
  "name": "seopilot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @seopilot/web dev",
    "dev:worker": "pnpm --filter @seopilot/worker dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @seopilot/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:generate": "pnpm --filter @seopilot/db generate",
    "db:migrate": "pnpm --filter @seopilot/db migrate",
    "db:seed": "pnpm --filter @seopilot/db seed",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "license:check": "node scripts/license-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "dotenv": "^17.2.1",
    "pg": "^8.23.0",
    "@types/pg": "^8.15.5"
  }
}
