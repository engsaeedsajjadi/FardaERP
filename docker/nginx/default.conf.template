# FardaERP frontend — served by the official nginx image's envsubst mechanism
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf with env vars).
# FRAPPE_SITE_NAME_HEADER = the Frappe site served (compose sets it to SITE_NAME),
# so the site works whatever hostname/IP the browser uses (CORE-017).
# Resolve backend/websocket through Docker's DNS on every request (cached 10s):
# a static upstream keeps the IP from nginx start-up, so after
# `docker compose restart backend` the old IP gave 502 Bad Gateway until the
# frontend was restarted too.
resolver 127.0.0.11 valid=10s ipv6=off;
server {
    listen 8080;
    server_name _;
    set $farda_site "${FRAPPE_SITE_NAME_HEADER}";
    set $farda_backend http://backend:8000;
    set $farda_websocket http://websocket:9000;
    client_max_body_size 50m;
    # container healthcheck (independent of any site)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
    # built JS/CSS assets (copied into the image at build time)
    # CORE-023: only content-hashed bundles (/assets/<app>/dist/...) may be cached
    # forever. Unhashed files such as farda_ui.js / farda_*.css / fonts keep their
    # URL across releases, so they must revalidate or users never get fixes.
    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        access_log off;
        location ~ ^/assets/[^/]+/dist/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }
    # public files live on the shared sites volume: <site>/public/files
    location /files/ {
        alias /var/www/sites/$farda_site/public/files/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
    }
    # private files (/private/files/…) are NOT served here: they fall through to
    # frappe (location /), which checks the user's permission and streams the
    # file. An internal-only block here made every private download a 404.
    location /protected/ {
        internal;
        alias /var/www/sites/$farda_site/protected/;
    }
    # realtime (socketio)
    location /socket.io {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # CORE-021: Frappe's socket.io server (a) rejects the handshake unless the
        # Host and Origin hostnames match ("Invalid origin": browsers send no Origin
        # on same-origin polling) and (b) calls back into Frappe at the Origin URL
        # to authenticate the user. Point both at this nginx service so the
        # callback is reachable from the websocket container; the site comes from
        # X-Frappe-Site-Name.
        proxy_set_header Host frontend;
        proxy_set_header Origin http://frontend:8080;
        proxy_set_header X-Frappe-Site-Name $farda_site;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_pass $farda_websocket;
    }
    # everything else -> gunicorn/frappe
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frappe-Site-Name $farda_site;
        proxy_read_timeout 120s;
        proxy_pass $farda_backend;
    }
}
