# FardaERP frontend — served by the official nginx image's envsubst mechanism
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf with env vars).
# FRAPPE_SITE_NAME_HEADER defaults to `$host` (multi-site by Host header).
upstream backend_up { server backend:8000; }
upstream websocket_up { server websocket:9000; }
server {
    listen 8080;
    server_name _;
    # built JS/CSS assets (copied into the image at build time)
    location /assets/ {
        alias /usr/share/nginx/html/assets/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }
    # public files live on the shared sites volume: <site>/public/files
    location /files/ {
        alias /var/www/sites/$host/public/files/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
    }
    # private files are only delivered via frappe's X-Accel-Redirect
    location /private/files/ {
        internal;
        alias /var/www/sites/$host/private/files/;
    }
    location /protected/ {
        internal;
        alias /var/www/sites/$host/protected/;
    }
    # realtime (socketio)
    location /socket.io {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_pass http://websocket_up;
    }
    # everything else -> gunicorn/frappe
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frappe-Site-Name $host;
        proxy_read_timeout 120s;
        proxy_pass http://backend_up;
    }
}
